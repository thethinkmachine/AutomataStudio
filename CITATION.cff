    given-names: Shreyan
    alias: thethinkmachine
version: 3.1.4
license: LicenseRef-PolyForm-Noncommercial-1.0.0
repository-code: "https://github.com/thethinkmachine/AutomataStudio"
url: "https://thethinkmachine.github.io/AutomataStudio/"
keywords:
  - automata theory
  - formal languages
  - Turing machines
  - pushdown automata
  - omega-automata
  - context-free grammars
  - simulation
  - education
