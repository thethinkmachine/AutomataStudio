  "notes": [
    {
      "id": "n1", "x": 110, "y": 70, "color": "blue",
      "anchorStates": [], "anchorTransitions": [],
      "text": "The float-literal regex [+-]?d+(.d+)? compiled to states (d = any digit). The ε edge silently skips the optional sign; the decimal branch only opens after at least one digit. This is Thompson construction — the machinery inside every regex engine."
    },
    {
      "id": "n2", "x": 110, "y": 400, "color": "green",
      "anchorStates": [], "anchorTransitions": [],
      "text": "Step through dd.dd and watch the ε-closure fire before any input is read. d. and .dd both fail — each for a different reason."
    }
  ],
  "meta": {
    "title": "Float regex, compiled",
    "blurb": "The regex [+-]?d+(.d+)? as an ε-NFA, where d stands for any digit — what a regex engine actually builds. ε-jumps make the sign optional; the fraction needs a digit after the dot.",
    "inputs": [
      { "w": "dd", "expect": "accept", "label": "like 42" },
      { "w": "+ddd", "expect": "accept", "label": "like +314" },
      { "w": "dd.dd", "expect": "accept", "label": "like 31.41" },
      { "w": "-d.d", "expect": "accept", "label": "like -2.5" },
      { "w": "d.", "expect": "reject", "label": "trailing dot" },
      { "w": ".dd", "expect": "reject", "label": "no integer part" }
