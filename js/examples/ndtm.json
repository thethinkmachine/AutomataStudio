  "notes": [
    {
      "id": "n1", "x": 30, "y": 40, "color": "blue",
      "anchorStates": [], "anchorTransitions": [],
      "text": "Compositeness by guessing: on input 1ⁿ the machine nondeterministically marks a factor p ≥ 2 as a ruler (#X…X), then deals the remaining 1s into rounds of exactly p. Every round completes cleanly ⇔ p divides n ⇔ n is composite."
    },
    {
      "id": "n2", "x": 950, "y": 220, "color": "green",
      "anchorStates": [], "anchorTransitions": [],
      "text": "1s get crossed to D one per ruler cell; the ruler resets (x→X) between rounds. If the 1s run out mid-round, that guess dies — only a correct factor survives."
    },
    {
      "id": "n3", "x": 950, "y": 420, "color": "orange",
      "anchorStates": [], "anchorTransitions": [],
      "text": "The trace shows breadth-first exploration over ALL guesses of p at once, not a single run — that's what the N in NDTM means."
    }
  ],
  "meta": {
    "title": "Is n composite? Guess a factor",
