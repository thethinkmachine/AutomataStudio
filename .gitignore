# Dependencies
node_modules/

# Build output, each regenerated by an npm script: the website (npm run
# build), the `automata` bundle (npm run cli:build) and the installers
# (npm run electron:build). build/ is not output — it is electron-builder's
# committed resources folder (the icon, the CLI launchers).
dist/
dist-cli/
release/
.vite/

# Intermediate output of scripts/build-wasm.mjs. js/wasm/*-bytes.js is the
# committed artifact the app loads; the .wasm it is made from is not.
wasm/*.wasm

# The local machine-library checkout (npm run library:dev)
.library-dev/

# Logs and coverage
*.log
npm-debug.log*
coverage/

# Python byte code — examples/cli/ ships a generated .py a reader may run
__pycache__/

# Environment and secrets
.env
.env.*

# OS and editor files
.DS_Store
Thumbs.db
.idea/
*.swp
