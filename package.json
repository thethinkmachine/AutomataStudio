{
  "name": "automata-playground",
  "version": "1.0.0",
  "description": "A web-based visualizer and simulator for finite state machines, pushdown automata, and Turing machines.",
  "author": {
    "name": "Shreyan C",
    "email": "shreyan.chaubey@gmail.com"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "devDependencies": {
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "terser": "^5.49.0",
    "vite": "^7.3.1",
    "wait-on": "^8.0.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test --test-concurrency=2 tests/*.test.js",
    "electron:dev": "concurrently -k -s first \"npm:dev\" \"wait-on http://localhost:5173 && cross-env ELECTRON_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:preview": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.automataplayground.app",
    "productName": "Automata Playground",
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": ["nsis"]
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.education"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Education"
    }
  }
}
